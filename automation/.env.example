# Variables de entorno del worker de certificados (CertiCheck).
# Copia como automation/.env y ajusta. Los defaults replican los de
# automation/config.py / captcha_solver.py.

# --- Conexión a Redis -------------------------------------------------------
# EN PRODUCCIÓN (docker-stack.prod.yml): apuntar al hostname interno del
# servicio Redis administrado por Coolify (ej. REDIS_HOST=redis-admin,
# REDIS_PORT=6379). El mismo REDIS_HOST/REDIS_PORT deben configurarse en
# Coolify para este stack.
# EN DESARROLLO LOCAL: el worker corre dentro de docker-compose.yml, que trae su
# propio servicio Redis y fija REDIS_HOST/REDIS_PORT automáticamente; si se
# ejecuta el worker directo (fuera de Docker), se usan los defaults de abajo.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_NAME=certificate_jobs

# --- Conexión a la API interna de Laravel ------------------------------------
# En el VPS de producción debe ser la URL por la que el worker alcanza a Laravel
# vía Coolify (NO host.docker.internal; eso solo existe en Docker Desktop).
LARAVEL_BASE_URL=http://127.0.0.1:8000
# Clave interna para autenticarse ante Laravel. Generar con: openssl rand -hex 32
# Debe coincidir con INTERNAL_API_KEY del .env de Laravel.
INTERNAL_API_KEY=

# --- Concurrencia ------------------------------------------------------------
# Pool general de hilos del worker.
WORKER_POOL_SIZE=10
# Límites de concurrencia independientes por sitio (por réplica).
MAX_CONCURRENCY_RNMC=4
MAX_CONCURRENCY_CONTRALORIA=2
MAX_CONCURRENCY_POLICIA_JUDICIAL=2
MAX_CONCURRENCY_PROCURADURIA=1

# --- Apagado ordenado y reencolado --------------------------------------------
# Segundos a esperar por los jobs en curso al recibir SIGTERM antes de forzar
# la salida durante el shutdown ordenado. Debe ser <= stop_grace_period del
# servicio worker en el stack.
SHUTDOWN_WAIT_SECONDS=60
# Máx. veces que un job que salió de la cola pero NO se ejecutó puede volver a
# encolarse al recibir SIGTERM / llegar al timeout. Al agotarlo queda sin
# procesar y se registra en CRITICAL para atención manual.
MAX_REQUEUE_ATTEMPTS=3

# --- Semáforo distribuido ------------------------------------------------------
# Lease (segundos) de cada permiso del semáforo por sitio. Si un worker crashea
# a mitad de un job, su permiso expira solo al cabo de este tiempo.
SEMAPHORE_LEASE_SECONDS=180
# Tiempo máximo (segundos) que un job espera a que se libere un permiso para su
# sitio antes de declararse como fallido (timeout).
SEMAPHORE_ACQUIRE_TIMEOUT=600

# --- CAPTCHA ---------------------------------------------------------------------
# Clave de CapSolver (proveedor principal de resolución de reCAPTCHA).
# Si se deja vacía, el worker omite ese proveedor.
CAPSOLVER_API_KEY=
# Clave de 2Captcha (fallback si CapSolver falla). Vacía = omitir.
TWOCAPTCHA_API_KEY=

# --- Modo DRY_RUN ---------------------------------------------------------------
# IMPORTANTE: en producción este valor se FIJÓ en "false" en docker-stack.prod.yml
# y NO se lee de variables de entorno, para evitar activarlo por accidente.
# Solamente el desarrollo local / stack de pruebas (docker-compose.yml +
# docker-compose.override.yml, docker-stack.yml) lo usa en true.
# true = simula el flujo completo sin lanzar Playwright ni tocar portales.
DRY_RUN=false
# Duración (segundos) del sleep que simula el trabajo cuando DRY_RUN=true.
DRY_RUN_DURATION_SECONDS=2

# --- Directorio temporal -----------------------------------------------------------
# Donde los scrapers escriben los PDFs antes de subirlos a Laravel.
TEMP_CERTS_DIR=./temp_certs